{
  "name": "cinematic-edge-motion",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src scripts vite.config.ts eslint.config.js --max-warnings=0",
    "lint:fix": "eslint src scripts vite.config.ts eslint.config.js --fix",
    "typecheck": "tsc --noEmit",
    "validate:project": "node scripts/validate-project.mjs",
    "build": "bun run validate:project && bun run lint && bun run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "bun run build",
    "bun:untrusted": "bun pm untrusted",
    "verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1",
    "lockfile:generate": "bun install"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "sass": "1.105.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}

{
  "name": "cinematic-edge-motion",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src scripts vite.config.ts eslint.config.js --max-warnings=0",
    "lint:fix": "eslint src scripts vite.config.ts eslint.config.js --fix",
    "typecheck": "tsc --noEmit",
    "validate:project": "node scripts/validate-project.mjs",
    "build": "npm run validate:project && npm run lint && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "npm run build",
    "lockfile:generate": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "sass": "1.105.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
